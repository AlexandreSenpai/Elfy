{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elfy",
  "version": "0.1.0",
  "identifier": "com.alexandresenpai.elfy",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Elfy",
        "label": "main",
        "url": "index.html#/",
        "width": 360,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "title": "Elfy Hub • Screen Share",
        "label": "stream",
        "url": "index.html#/stream",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "title": "Elfy • Setup",
        "label": "register",
        "url": "index.html#/register",
        "width": 580,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
